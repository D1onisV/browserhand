{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "BrowserHand",
  "version": "0.7.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "permissions": [
    "tabs",
    "scripting",
    "debugger",
    "webRequest",
    "alarms",
    "storage",
    "userScripts"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/console-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/page.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content/cookie-banner.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "__MSG_openChat__"
    }
  },
  "action": {
    "default_popup": "ui/chat.html?popup=1",
    "default_title": "__MSG_name__",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "homepage_url": "https://github.com/D1onisV/browserhand"
}
